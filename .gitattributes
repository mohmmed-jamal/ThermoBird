# Normalize line endings: store as LF in Git, checkout as-is
* text=auto eol=lf

# Force LF for files that must be LF on Linux (Docker, shell scripts)
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
